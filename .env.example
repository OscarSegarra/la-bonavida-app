# Copy this file to .env.local for local development.
# Local dev should point at the PREPROD Supabase project — never prod.
# Get these values from: Supabase Dashboard > Project Settings > API
# (or `mcp__supabase__get_project_url` / `get_publishable_keys` in a session).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never exposed to the browser, never committed.
# Needed by `pnpm run seed:ingredients`, which is the only thing that
# writes to the admin-curated ingredient catalog — every other table is
# reached through the publishable key plus RLS. The app itself never reads
# this, and it must never be given a NEXT_PUBLIC_ prefix or added to
# Vercel: it bypasses RLS entirely, so anyone holding it can read and
# write every household's data.
#
# This project uses Supabase's newer API keys, so the value to paste is a
# SECRET key (`sb_secret_…`) from Project Settings → API Keys → Secret
# keys — not the Publishable key above, and not a legacy `eyJ…`
# service_role JWT. The variable name predates that rename; a secret key
# maps to the same service_role Postgres role, so it works as-is.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. The canonical origin for this deployment (no trailing
# slash) - used to build the magic-link email's redirect URL. Set this per
# environment (local: http://localhost:3000; preview/production: the real
# Vercel URL) - never derive it from client-supplied input, that was an
# open-redirect / auth-code-hijack vector caught in review (see
# DECISIONS.md).
SITE_URL=http://localhost:3000
