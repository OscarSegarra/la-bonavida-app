# Copy this file to .env.local for local development.
# Local dev should point at the PREPROD Supabase project — never prod.
# Get these values from: Supabase Dashboard > Project Settings > API
# (or `mcp__supabase__get_project_url` / `get_publishable_keys` in a session).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never exposed to the browser, never committed.
# Not needed yet — leave blank until a module requires bypassing RLS
# (e.g. an admin task). Most server code should use the anon key + RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. The canonical origin for this deployment (no trailing
# slash) - used to build the magic-link email's redirect URL. Set this per
# environment (local: http://localhost:3000; preview/production: the real
# Vercel URL) - never derive it from client-supplied input, that was an
# open-redirect / auth-code-hijack vector caught in review (see
# DECISIONS.md).
SITE_URL=http://localhost:3000
